# 复制为 .env，或运行 scripts/init.ps1。请使用项目专用数据库账户。
DATABASE_URL=mysql+pymysql://registration_app:CHANGE_ME@127.0.0.1:3306/course_registration?charset=utf8mb4
# 私有实例由初始化器配置 CA；真实数据库可设置受信任的 CA 文件路径。
DATABASE_SSL_CA=
ENCRYPTION_KEY=GENERATE_FERNET_KEY
INTEGRATION_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
CATALOG_DATABASE_URL=mysql+pymysql://registration_catalog:CHANGE_ME@127.0.0.1:3306/course_registration?charset=utf8mb4
CATALOG_MODE=http
CATALOG_CACHE_SECONDS=60
CATALOG_URL=http://127.0.0.1:8001/catalog
BILLING_URL=http://127.0.0.1:8002/events
COOKIE_SECURE=false
APP_ENV=development
